@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Usuários</h1>
    <a class="btn btn-primary" asp-action="Create">+ Novo usuário</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>E-mail</th>
                    <th>Perfil</th>
                    <th>Setor</th>
                    <th>Situação</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td class="fw-semibold">@usuario.Nome</td>
                    <td class="small">@usuario.Email</td>
                    <td><span class="badge bg-@UiHelper.CorPerfil(usuario.Perfil)">@usuario.Perfil.Texto()</span></td>
                    <td class="small">@(usuario.Setor ?? "-")</td>
                    <td>
                        @if (usuario.Ativo)
                        {
                            <span class="badge bg-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inativo</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-inline-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form asp-action="AlternarAtivo" asp-route-id="@usuario.Id" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-@(usuario.Ativo ? "danger" : "success")">
                                    @(usuario.Ativo ? "Desativar" : "Ativar")
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
